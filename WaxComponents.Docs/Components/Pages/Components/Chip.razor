@page "/component/chip"
@rendermode InteractiveServer
@using WaxComponents.Chip
@using WaxComponents.Tabs

<PageTitle>Chip - Wax Components</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-display font-bold text-foreground mb-2">Chip</h1>
    <p class="text-muted-foreground">Compact elements for filters, suggestions, and input tokens.</p>
</div>

<div class="space-y-6">
    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Filter Chips</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_filterTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Suggestion Chips</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_suggestionTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Input Chips</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_inputTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">With Icons</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_iconTabs" TabListClass="mb-4" />
    </div>
</div>

@code {
    private List<WaxTabItem> _filterTabs = [];
    private List<WaxTabItem> _suggestionTabs = [];
    private List<WaxTabItem> _inputTabs = [];
    private static List<WaxTabItem> _iconTabs =
    [
        new("Preview", Content: @<div class="flex flex-wrap gap-2">
            <WaxChip Icon="coffee">Coffee</WaxChip>
            <WaxChip Icon="leaf">Nature</WaxChip>
            <WaxChip Icon="bell">Alerts</WaxChip>
            <WaxChip Icon="settings">Settings</WaxChip>
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_iconCode</code></pre>, Icon: "code")
    ];

    private List<string> _filterChips = ["Coffee", "Tea", "Juice", "Milk"];
    private HashSet<string> _filterSelected = [];

    private void ToggleFilter(string chip, bool selected)
    {
        if (selected) _filterSelected.Add(chip);
        else _filterSelected.Remove(chip);
    }

    private List<string> _suggestions = ["Design", "Blazor", "AI", "Tailwind"];
    private string? _suggestion;

    private void SelectSuggestion(string chip, bool selected)
    {
        _suggestion = selected ? chip : null;
    }

    private List<string> _inputChips = ["C#", ".NET", "Tailwind", "Blazor"];
    private List<string> _inputChipList = [];

    private void RemoveChip(string chip) => _inputChipList.Remove(chip);
    private void ResetInputChips() => _inputChipList = _inputChips.ToList();

    private static string _filterCode = "@using WaxComponents.Chip\n\n@foreach (var chip in _filterChips)\n{\n    <WaxChip Value=\"@_filterSelected.Contains(chip)\" ValueChanged=\"@(v => ToggleFilter(chip, v))\">\n        @chip\n    </WaxChip>\n}\n\n@code {\n    private List<string> _filterChips = [\"Coffee\", \"Tea\", \"Juice\", \"Milk\"];\n    private HashSet<string> _filterSelected = [];\n\n    private void ToggleFilter(string chip, bool selected)\n    {\n        if (selected) _filterSelected.Add(chip);\n        else _filterSelected.Remove(chip);\n    }\n}";

    private static string _suggestionCode = "@using WaxComponents.Chip\n\n@foreach (var chip in _suggestions)\n{\n    <WaxChip Variant=\"WaxChipVariant.Suggestion\"\n             Value=\"@(_suggestion == chip)\"\n             ValueChanged=\"@(v => SelectSuggestion(chip, v))\">\n        @chip\n    </WaxChip>\n}\n\n@code {\n    private List<string> _suggestions = [\"Design\", \"Blazor\", \"AI\", \"Tailwind\"];\n    private string? _suggestion;\n\n    private void SelectSuggestion(string chip, bool selected)\n    {\n        _suggestion = selected ? chip : null;\n    }\n}";

    private static string _inputCode = "@using WaxComponents.Chip\n\n@foreach (var chip in _inputChipList)\n{\n    <WaxChip Variant=\"WaxChipVariant.Input\" Value=\"true\" OnRemove=\"@(_ => RemoveChip(chip))\">\n        @chip\n    </WaxChip>\n}\n@if (_inputChipList.Count < _inputChips.Count)\n{\n    <button class=\"text-xs text-primary underline underline-offset-2 cursor-pointer bg-transparent border-none\"\n            @onclick=\"ResetInputChips\">\n        Reset\n    </button>\n}\n\n@code {\n    private List<string> _inputChips = [\"C#\", \".NET\", \"Tailwind\", \"Blazor\"];\n    private List<string> _inputChipList = [\"C#\", \".NET\", \"Tailwind\", \"Blazor\"];\n\n    private void RemoveChip(string chip) => _inputChipList.Remove(chip);\n    private void ResetInputChips() => _inputChipList = _inputChips.ToList();\n}";

    private static string _iconCode = "@using WaxComponents.Chip\n\n<div class=\"flex flex-wrap gap-2\">\n    <WaxChip Icon=\"coffee\">Coffee</WaxChip>\n    <WaxChip Icon=\"leaf\">Nature</WaxChip>\n    <WaxChip Icon=\"bell\">Alerts</WaxChip>\n    <WaxChip Icon=\"settings\">Settings</WaxChip>\n</div>";

    protected override void OnInitialized()
    {
        _inputChipList = _inputChips.ToList();

        _filterTabs =
        [
            new("Preview", Content: @<div class="flex flex-wrap gap-2">
                @foreach (var chip in _filterChips)
                {
                    <WaxChip Value="@_filterSelected.Contains(chip)" ValueChanged="@(v => ToggleFilter(chip, v))">
                        @chip
                    </WaxChip>
                }
            </div>, Icon: "monitor-dot"),
            new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_filterCode</code></pre>, Icon: "code")
        ];

        _suggestionTabs =
        [
            new("Preview", Content: @<div class="flex flex-wrap gap-2">
                @foreach (var chip in _suggestions)
                {
                    <WaxChip Variant="WaxChipVariant.Suggestion"
                             Value="@(_suggestion == chip)"
                             ValueChanged="@(v => SelectSuggestion(chip, v))">
                        @chip
                    </WaxChip>
                }
            </div>, Icon: "monitor-dot"),
            new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_suggestionCode</code></pre>, Icon: "code")
        ];

        _inputTabs =
        [
            new("Preview", Content: @<div class="flex flex-wrap gap-2">
                @foreach (var chip in _inputChipList)
                {
                    <WaxChip Variant="WaxChipVariant.Input" Value="true" OnRemove="@(_ => RemoveChip(chip))">
                        @chip
                    </WaxChip>
                }
                @if (_inputChipList.Count < _inputChips.Count)
                {
                    <button class="text-xs text-primary underline underline-offset-2 cursor-pointer bg-transparent border-none"
                            @onclick="ResetInputChips">
                        Reset
                    </button>
                }
            </div>, Icon: "monitor-dot"),
            new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_inputCode</code></pre>, Icon: "code")
        ];
    }
}
