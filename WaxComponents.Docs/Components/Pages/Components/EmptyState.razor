@page "/component/empty-state"
@rendermode InteractiveServer
@using LucideBlazor
@using WaxComponents.Card
@using WaxComponents.EmptyState
@using WaxComponents.Tabs

<PageTitle>Empty State - Wax Components</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-display font-bold text-foreground mb-2">Empty State</h1>
    <p class="text-muted-foreground">Placeholder content for empty lists, searches, and new workspaces.</p>
</div>

<div class="space-y-6">
    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">Basic</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_basicTabs" TabListClass="mb-4" />
    </div>

    <div class="p-6 rounded-3xl bg-card border border-border">
        <h3 class="font-semibold text-foreground mb-1">In a Card</h3>
        <WaxTab Variant="WaxTabVariant.Primary" Tabs="_cardTabs" TabListClass="mb-4" />
    </div>
</div>

@code {
    private static List<WaxTabItem> _basicTabs =
    [
        new("Preview", Content: @<div class="space-y-3">
            <WaxEmptyState Headline="No messages yet"
                           Detail="Start a conversation and it will show up here." />
            <WaxEmptyState Headline="No results found"
                           Detail="Try adjusting your search or filters." />
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_basicCode</code></pre>, Icon: "code")
    ];

    private static List<WaxTabItem> _cardTabs =
    [
        new("Preview", Content: @<div class="max-w-md">
            <WaxCard Variant="WaxCardVariant.Outlined" Hoverable="false" Class="flex flex-col items-center py-10 text-center">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15">
                    <LucideIcon Name="inbox" Size="24" ClassName="text-primary" />
                </div>
                <WaxEmptyState Headline="Your inbox is empty"
                               Detail="New notifications will appear here." />
            </WaxCard>
        </div>, Icon: "monitor-dot"),
        new("Code", Content: @<pre class="bg-muted rounded-xl p-4 overflow-x-auto text-sm"><code>@_cardCode</code></pre>, Icon: "code")
    ];

    private static string _basicCode = """
        @using WaxComponents.EmptyState

        <WaxEmptyState Headline="No messages yet"
                       Detail="Start a conversation and it will show up here." />

        <WaxEmptyState Headline="No results found"
                       Detail="Try adjusting your search or filters." />
        """;

    private static string _cardCode = """
        @using LucideBlazor
        @using WaxComponents.Card
        @using WaxComponents.EmptyState

        <WaxCard Variant="WaxCardVariant.Outlined" Hoverable="false" Class="flex flex-col items-center py-10 text-center">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15">
                <LucideIcon Name="inbox" Size="24" ClassName="text-primary" />
            </div>
            <WaxEmptyState Headline="Your inbox is empty"
                           Detail="New notifications will appear here." />
        </WaxCard>
        """;
}
