@using WaxComponents.Theme
@using WaxComponents.Services.Theme
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en" class="@ThemeClassAttr">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <BasePath/>
    <ResourcePreloader/>
    <ThemePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["WaxComponents.Docs.styles.css"]"/>
    <link rel="stylesheet" href="_content/WaxComponents/app.css" />
    <ImportMap/>
    <FontMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<Routes/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Blazor's enhanced SSR navigation patches the <html> class attribute from
    // the server response, wiping the preloader-applied theme class off and
    // flashing the wrong theme until interop re-applies it. SSR the current
    // theme class from the cookie the theme module maintains instead, so the
    // patch matches the client-applied value.
    private string? ThemeClassAttr => ThemeCookie.ReadThemeClass(HttpContextAccessor.HttpContext);
}