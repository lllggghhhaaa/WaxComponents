@using WaxComponents.Utils

@inherits WaxComponent

<button type="button"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        aria-label="@Title"
        title="@Title"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter] public WaxIconButtonSize Size { get; set; } = WaxIconButtonSize.Medium;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string Base =
        "inline-flex shrink-0 items-center justify-center rounded-2xl select-none transition-all duration-200 active:scale-95";

    private string SizeClass => Size switch
    {
        WaxIconButtonSize.XSmall => "h-7 w-7",
        WaxIconButtonSize.Small => "h-8 w-8 text-sm",
        WaxIconButtonSize.Medium => "h-9 w-9",
        WaxIconButtonSize.Large => "h-10 w-10 text-lg",
        WaxIconButtonSize.XLarge => "h-11 w-11",
        _ => throw new ArgumentOutOfRangeException(nameof(Size)),
    };

    private string ActiveClass => Active
        ? "bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground"
        : "bg-transparent text-muted-foreground hover:bg-muted hover:text-foreground";

    private string DisabledClass =>
        Disabled ? "opacity-40 pointer-events-none cursor-not-allowed" : "cursor-pointer";

    private string CssClass =>
        Base.MergeClass(SizeClass, ActiveClass, DisabledClass, Class);

    private Task HandleClick()
        => Disabled ? Task.CompletedTask : OnClick.InvokeAsync();
}
