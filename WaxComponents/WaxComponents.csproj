<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Title>WaxComponents</Title>
        <Authors>lllggghhhaaaa</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/lllggghhhaaa/WaxComponents</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>blazor</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>0.9.4</PackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <PropertyGroup>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</RepoRoot>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="wwwroot\app.css" />
        <Content Remove="wwwroot\tokens.css" />
    </ItemGroup>

    <!-- Tailwind CSS pipeline. Scans ONLY this project's sources (see app.css). -->
    <Target Name="NpmInstall" BeforeTargets="BuildTailwind" Condition="!Exists('$(RepoRoot)node_modules/@tailwindcss/cli/package.json')">
        <Exec Command="npm ci --no-audit --no-fund --loglevel=error" WorkingDirectory="$(RepoRoot)" />
    </Target>

    <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall"
            Inputs="app.css;Theme\**\*.css;**\*.razor;**\*.cs"
            Outputs="wwwroot\app.css;wwwroot\tokens.css">
        <Exec Command="npm run build:css" Condition="'$(Configuration)' != 'Release'" />
        <Exec Command="npm run build:css:min" Condition="'$(Configuration)' == 'Release'" />
        <Copy SourceFiles="Theme\tokens.css" DestinationFiles="wwwroot\tokens.css" SkipUnchangedFiles="true" />
        <ItemGroup>
            <Content Include="wwwroot\app.css" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="wwwroot\tokens.css" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LucideBlazor" Version="1.0.6" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

</Project>
