<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Title>WaxComponents</Title>
        <Authors>lllggghhhaaaa</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/lllggghhhaaa/WaxComponents</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>blazor</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>0.9.9</PackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <PropertyGroup>
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</RepoRoot>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="wwwroot\app.css" />
        <Content Remove="wwwroot\tokens.css" />
        <Content Remove="wwwroot\js\theme.js" />
        <Content Remove="wwwroot\js\colorPicker.js" />
        <Content Remove="wwwroot\js\dialog.js" />
        <Content Remove="wwwroot\js\popover.js" />
    </ItemGroup>

    <!-- Shared npm pipeline bootstrap (Tailwind CSS + TypeScript/esbuild). -->
    <Target Name="NpmInstall" BeforeTargets="BuildTailwind;BuildScripts"
            Condition="!Exists('$(RepoRoot)node_modules/@tailwindcss/cli/package.json') Or !Exists('$(RepoRoot)node_modules/typescript/package.json') Or !Exists('$(RepoRoot)node_modules/esbuild/package.json')">
        <Exec Command="npm ci --no-audit --no-fund --loglevel=error" WorkingDirectory="$(RepoRoot)" />
    </Target>

    <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall"
            Inputs="app.css;Theme\**\*.css;**\*.razor;**\*.cs"
            Outputs="wwwroot\app.css;wwwroot\tokens.css">
        <Exec Command="npm run build:css" Condition="'$(Configuration)' != 'Release'" />
        <Exec Command="npm run build:css:min" Condition="'$(Configuration)' == 'Release'" />
        <Copy SourceFiles="Theme\tokens.css" DestinationFiles="wwwroot\tokens.css" SkipUnchangedFiles="true" />
        <ItemGroup>
            <Content Include="wwwroot\app.css" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="wwwroot\tokens.css" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- TypeScript pipeline. Sources in Scripts/, compiled by esbuild: theme.js (ES module
         used by ThemeService), colorPicker.js (ES module used by WaxColorPickerJs),
         dialog.js (ES module used by WaxDialogJs), popover.js (ES module used by
         WaxPopoverJs) and ThemePreloaderScript.generated.cs (inline <head> script const
         rendered by ThemePreloader.razor, kept inline to avoid a theme flash). -->
    <Target Name="BuildScripts" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall"
            Inputs="Scripts\**\*.ts;Scripts\*.mjs;tsconfig.json"
            Outputs="wwwroot\js\theme.js;wwwroot\js\colorPicker.js;wwwroot\js\dialog.js;wwwroot\js\popover.js;Services\Theme\ThemePreloaderScript.generated.cs">
        <Exec Command="npm run build:js" Condition="'$(Configuration)' != 'Release'" />
        <Exec Command="npm run build:js:min" Condition="'$(Configuration)' == 'Release'" />
        <ItemGroup>
            <Content Include="wwwroot\js\theme.js" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="wwwroot\js\colorPicker.js" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="wwwroot\js\dialog.js" CopyToPublishDirectory="PreserveNewest" />
            <Content Include="wwwroot\js\popover.js" CopyToPublishDirectory="PreserveNewest" />
            <!-- Remove+Include so an evaluation-time glob of the generated file is not compiled twice. -->
            <Compile Remove="Services\Theme\ThemePreloaderScript.generated.cs" />
            <Compile Include="Services\Theme\ThemePreloaderScript.generated.cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <!-- HttpContext is needed by ThemeCookie (server-rendered <html class> for
         enhanced-navigation theme correctness) and to give docs/apps access. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LucideBlazor" Version="1.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>


</Project>
