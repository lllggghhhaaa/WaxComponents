@using LucideBlazor
@using WaxComponents.Spoiler
@using WaxComponents.Utils

@inherits WaxComponent

<button @onclick="Toggle" class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <LucideIcon Size="14" Name="@Icon" ClassName="ml-0.5" />
    }

    @if (Spoiler)
    {
        <span class="@SpoilerWrapperClass">
            <span class="@SpoilerContentClass">@ChildContent</span>
            <span class="@SpoilerVeilClass" aria-hidden="true">
                <LucideIcon Name="eye" Size="12" ClassName="@WaxSpoilerStyles.Hint"/>
            </span>
        </span>
    }
    else
    {
        @ChildContent
    }

    @if (Value)
    {
        <LucideIcon Size="14" Name="check" ClassName="ml-0.5" />
    }

    @if (Variant == WaxChipVariant.Input)
    {
        <button type="button"
                class="ml-1 opacity-60 hover:opacity-100"
                @onclick:stopPropagation
                @onclick="@(_ => OnRemove.InvokeAsync())">
            <LucideIcon Name="x" Size="12"/>
        </button>
    }
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public WaxChipVariant Variant { get; set; } = WaxChipVariant.Filter;

    /// <summary>Hides the chip label behind a blur + gradient veil. The first click reveals it instead of toggling.</summary>
    [Parameter] public bool Spoiler { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private bool _spoilerRevealed;

    private string Base =>
        "inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer";

    private string SelectedClass =>
        Value
            ? "bg-primary text-primary-foreground shadow-sm"
            : "bg-muted text-foreground hover:bg-[#E8D4C0] border border-border";

    private string VariantClass =>
        Variant == WaxChipVariant.Input ? "pr-2" : string.Empty;

    private string SpoilerWrapperClass => WaxSpoilerStyles.Wrapper
        .MergeClass(
            "inline-block",
            _spoilerRevealed ? string.Empty : WaxSpoilerStyles.Hidden);

    private string SpoilerContentClass => "inline"
        .MergeClass(
            WaxSpoilerStyles.Content,
            _spoilerRevealed ? string.Empty : WaxSpoilerStyles.ContentBlurred);

    private string SpoilerVeilClass => WaxSpoilerStyles.Veil
        .MergeClass(_spoilerRevealed ? WaxSpoilerStyles.VeilHidden : WaxSpoilerStyles.VeilVisible);

    private string CssClass =>
        Base.MergeClass(
            SelectedClass,
            VariantClass,
            Class);

    private async Task Toggle()
    {
        if (Spoiler && !_spoilerRevealed)
        {
            _spoilerRevealed = true;
            return;
        }

        Value = !Value;

        await ValueChanged.InvokeAsync(Value);
        await OnToggle.InvokeAsync(Value);
    }

    private async Task Remove()
    {
        await OnRemove.InvokeAsync();
    }
}