@using WaxComponents.Card
@using WaxComponents.Button
@using WaxComponents.Utils
@using Microsoft.JSInterop
@inherits WaxComponent
@implements IAsyncDisposable
@inject IJSRuntime Js

@* Native <dialog>-based dialog. Open shows it with showModal() (default) or show()
   (Modal="false"); the JS module bridges cancel/close/backdrop back here so the
   Open parameter stays the single source of truth for what is on screen. *@
<dialog @ref="_dialog"
        class="@DialogCss"
        style="@Style"
        @attributes="AdditionalAttributes">
    <WaxCard Variant="WaxCardVariant.Elevated" Hoverable="false">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h3 class="mb-1.5 mt-0 text-lg">@Title</h3>
        }
        @if (DescriptionContent is not null)
        {
            <p class="mb-3 mt-0 text-[13px] text-muted-foreground">@DescriptionContent</p>
        }
        else if (!string.IsNullOrEmpty(Description))
        {
            <p class="mb-3 mt-0 text-[13px] text-muted-foreground">@Description</p>
        }

        @ChildContent

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="mb-2.5 mt-0 text-[13px] text-destructive">@Error</p>
        }

        @if (FooterContent is not null)
        {
            @FooterContent
        }
        else if (HasFooterButtons)
        {
            <div class="mt-3.5 flex items-center justify-end gap-2.5">
                @if (HasCancelButton)
                {
                    <WaxButton Variant="WaxButtonVariant.Text" OnClick="HandleCancelClick">
                        <ChildContent>@CancelText</ChildContent>
                    </WaxButton>
                }
                @if (HasConfirmButton)
                {
                    <WaxButton Variant="@ConfirmVariant" Disabled="@ConfirmDisabled" OnClick="HandleConfirmClick">
                        <ChildContent>@ConfirmText</ChildContent>
                    </WaxButton>
                }
            </div>
        }
    </WaxCard>
</dialog>

@code {
    [Parameter] public bool Open { get; set; }

    /// <summary>
    /// Modal by default: showModal() renders in the top layer with the native
    /// ::backdrop, focus trap and Escape handling. Modal="false" shows a non-modal
    /// floating dialog (show()) — the page stays interactive, there is no backdrop
    /// and CloseOnBackdrop is ignored.
    /// </summary>
    [Parameter] public bool Modal { get; set; } = true;

    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    /// <summary>Replaces the plain description paragraph with rich content (inline code, links…).</summary>
    [Parameter] public RenderFragment? DescriptionContent { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string CancelText { get; set; } = "Cancel";

    /// <summary>Text of the confirm button; omit for footerless dialogs (backdrop/cancel only).</summary>
    [Parameter] public string? ConfirmText { get; set; }

    [Parameter] public WaxButtonVariant ConfirmVariant { get; set; } = WaxButtonVariant.Filled;

    [Parameter] public bool ConfirmDisabled { get; set; }

    [Parameter] public EventCallback OnClosed { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Extra classes for the ::backdrop pseudo-element (tint, blur) — prefix utilities
    /// with <c>backdrop:</c>. Only applies to modal dialogs.
    /// </summary>
    [Parameter] public string BackdropClass { get; set; } = string.Empty;

    /// <summary>Whether clicking the backdrop closes the dialog (default true; modal only).</summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>Whether the Escape key closes the dialog (default false).</summary>
    [Parameter] public bool CloseOnEscape { get; set; }

    /// <summary>Anchors the card near the top instead of centering (long content).</summary>
    [Parameter] public bool AlignTop { get; set; }

    /// <summary>Dialog body between the description and the error/footer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Replaces the default cancel/confirm footer entirely.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    private ElementReference _dialog;

    private WaxDialogJs? _jsInterop;

    private DotNetObjectReference<WaxDialog>? _selfRef;

    // Whether the element is currently shown in JS, reconciled against Open on every
    // render so parameter flips and externally fired close events converge.
    private bool _shown;

    private bool _hidePending;

    private bool HasCancelButton => !string.IsNullOrEmpty(CancelText) && OnClosed.HasDelegate;

    private bool HasConfirmButton => !string.IsNullOrEmpty(ConfirmText) && OnConfirm.HasDelegate;

    private bool HasFooterButtons => FooterContent is null && (HasCancelButton || HasConfirmButton);

    private bool HasBackdropClose => OnClosed.HasDelegate;

    private string DialogCss
    {
        get
        {
            var position = AlignTop
                ? "top-[10vh] -translate-x-1/2"
                : "top-1/2 -translate-x-1/2 -translate-y-1/2";

            return ("fixed left-1/2 z-[75] w-[min(440px,calc(100vw-32px))] max-h-[min(640px,calc(100vh-64px))] "
                    + "overflow-y-auto border-0 bg-transparent p-0 text-current backdrop:bg-foreground/45 "
                    + position + " " + BackdropClass).MergeClass(Class);
        }
    }

    private DotNetObjectReference<WaxDialog> SelfRef => _selfRef ??= DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _jsInterop ??= new WaxDialogJs(Js);

        try
        {
            if (Open && !_shown)
            {
                _hidePending = false;
                await _jsInterop.InvokeAsync<object?>("show", _dialog, SelfRef,
                    new { modal = Modal, closeOnBackdrop = CloseOnBackdrop });
                _shown = true;
            }
            else if (!Open && _shown)
            {
                _hidePending = true;
                await _jsInterop.InvokeAsync<object?>("hide", _dialog);
                _shown = false;
            }
        }
        catch (ObjectDisposedException)
        {
            // The dialog was torn down between render and the interop call.
        }
    }

    private Task HandleCancelClick() => OnClosed.InvokeAsync();

    private Task HandleConfirmClick() => ConfirmDisabled ? Task.CompletedTask : OnConfirm.InvokeAsync();

    [JSInvokable]
    public Task OnWaxDialogCancel() =>
        CloseOnEscape ? OnClosed.InvokeAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task OnWaxDialogBackdropClick() =>
        CloseOnBackdrop && HasBackdropClose ? OnClosed.InvokeAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task OnWaxDialogClosed()
    {
        _shown = false;

        if (_hidePending)
        {
            // Close was requested from here (Open=false); OnClosed already ran.
            _hidePending = false;
            return Task.CompletedTask;
        }

        // Closed outside the render loop; sync the opener.
        return OnClosed.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_shown && _jsInterop is not null)
        {
            _shown = false;
            await _jsInterop.InvokeAsync<object?>("dispose", _dialog);
        }

        _selfRef?.Dispose();

        if (_jsInterop is not null)
        {
            await _jsInterop.DisposeAsync();
        }
    }
}
